{
  "name": "alchemize",
  "version": "1.0.0",
  "private": true,
  "description": "Alchemize Business Services website",
  "keywords": [
    "alchemize",
    "business-services",
    "static-site",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "pretest:e2e": "npm run build",
    "build": "npm run generate:sitemap && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:html": "htmlhint \"**/*.html\"",
    "check:links": "node scripts/check-links.js",
    "check:assets": "node scripts/check-assets.js",
    "check:security": "node scripts/security-scan.js",
    "check:dist": "node scripts/check-dist.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:checklists": "node scripts/run-checklist-generator.js",
    "generate:checklists:premium": "node scripts/run-checklist-generator.js --premium",
    "generate:resource-pdfs": "node scripts/run-resource-pdf-generator.js",
    "routes:list": "node scripts/discover-routes.js",
    "routes:check": "node scripts/routes-check.js",
    "metadata:check": "node scripts/check-metadata.js",
    "content:list": "node scripts/content-list.js",
    "content:check": "node scripts/content-check.js",
    "screenshots": "node scripts/screenshots.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "php:lint": "node scripts/php-lint.js",
    "php:test": "php tests/php/run.php",
    "test:contact": "node --test tests/contact-form.test.js",
    "test:communication": "node --test tests/communication-security.test.js",
    "test:intake": "node --test tests/intake-security.test.js",
    "test:portal": "node --test tests/portal-security.test.js",
    "migrations:check": "node scripts/check-migrations.js",
    "config:check": "php scripts/config-diagnostics.php",
    "schema:check": "php scripts/verify-production-schema.php",
    "predeploy": "node scripts/predeploy.js",
    "check": "npm run lint && npm run format:check && npm run validate:html && npm run routes:check && npm run metadata:check && npm run check:links && npm run check:assets && npm run check:security && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.1",
    "eslint": "^10.8.1",
    "htmlhint": "^1.9.2",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
