# Future project configuration placeholders.
# Add only non-secret values here.
# Example:
# VITE_CONTACT_FORM_ENDPOINT=
# VITE_ANALYTICS_ID=
# VITE_SCHEDULE_LINK=
# ALCHEMIZE_STRIPE_WEBHOOK_SECRET=

# Application and database (server-side only)
APP_ENV=production
APP_URL=https://example.com
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optional compatibility aliases take precedence over the conventional names.
# ALCHEMIZE_APP_ENV=
# ALCHEMIZE_APP_URL=
# ALCHEMIZE_DB_HOST=
# ALCHEMIZE_DB_PORT=
# ALCHEMIZE_DB_NAME=
# ALCHEMIZE_DB_USER=
# ALCHEMIZE_DB_PASSWORD=
# ALCHEMIZE_SERVER_BOOTSTRAP=/protected/path/alchemize-server/bootstrap.php

# Amazon SES SMTP (server-side only)
AWS_REGION=us-east-1
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_FROM_EMAIL=verified-sender@example.com
SES_FROM_NAME=Alchemize Business Services
SES_REPLY_TO_EMAIL=reply@example.com
